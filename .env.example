# ============================================
# REQUIRED
# ============================================
# Get your key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ============================================
# OPTIONAL
# ============================================
PORT=3000
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Email alerts for high-risk contracts (optional) ----
# If you set these, you'll get an email whenever a contract is flagged HIGH risk.
# Leave blank to disable email alerts entirely — everything else still works.
# Example values below are for Gmail (use an App Password, not your real password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAIL_TO=legal-team@yourcompany.com
